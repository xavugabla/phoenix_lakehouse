# Example environment variables for Prefect connections
# Copy this file to .env and fill in your values

# Prefect Cloud (Recommended for Production)
# Get your API key from https://app.prefect.cloud → Settings → API Keys
PREFECT_API_KEY=your-api-key-here

# Prefect Server (Local - Alternative to Cloud)
# Uncomment if using local Prefect server instead of Cloud
# PREFECT_API_URL=http://localhost:4200/api

# Google Cloud Storage
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
GCS_BUCKET=novogrid-workqueue

